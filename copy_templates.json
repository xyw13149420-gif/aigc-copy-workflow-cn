{
  "meta": {
    "name": "天猫/淘宝 宠物主粮文案模板库",
    "version": "1.0.0",
    "goal": "单篇文案产出 5 分钟 -> 3 分钟（输入 15s + 生成 3s + 审校 2min）",
    "division_of_labor": {
      "templates": "管结构与合规：标题骨架、卖点四段结构、话术场景分类、口播分镜、极限词黑名单与替换映射",
      "script": "管变量注入与组合去重：占位符填充、30 字校验、超长回退短模板、批次去重、合规扫描替换、耗时测算"
    },
    "placeholder_help": {
      "brand": "品牌名，来自 variable_pools.brand",
      "product": "商品名，由 --product 传入",
      "spec": "规格，由 --spec 传入",
      "price": "到手价，由 --price 传入",
      "audience": "人群，由 --audience 传入",
      "核心成分": "成分/原料证据，来自 variable_pools.ingredient",
      "功能": "可感知功效方向，来自 variable_pools.function",
      "人群": "短人群词，脚本按 audience 关键词推导",
      "场景": "使用场景，来自 variable_pools.scene",
      "数字卖点": "可量化卖点，来自 variable_pools.number_proof",
      "赠品": "赠品，来自 variable_pools.gift"
    },
    "disclaimer": "样例中的克重、蛋白含量、检测项数等数字为演示占位，正式投放前必须替换为实测值/检测报告数值。"
